#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    int freq[n];  // frequency array
    int visited = -1;

    // Read array
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        freq[i] = 1;  // initialize frequency
    }

    // Count frequencies
    for (int i = 0; i < n; i++) {
        if (freq[i] != visited) {  // not already counted
            int count = 1;
            for (int j = i + 1; j < n; j++) {
                if (arr[i] == arr[j]) {
                    count++;
                    freq[j] = visited;  // mark as counted
                }
            }
            freq[i] = count;
        }
    }

    // Print result
    for (int i = 0; i < n; i++) {
        if (freq[i] != visited) {
            printf("%d:%d ", arr[i], freq[i]);
        }
    }

    return 0;
}
